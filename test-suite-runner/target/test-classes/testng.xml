<suite name="NBA-Automation-Suite" parallel="tests" thread-count="3">

    <!-- Chrome Execution -->
    <test name="Run on Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.nba.automation.coreproduct.runner.CPRunner"/>
            <class name="com.nba.automation.DP1.runner.DP1TestRunner"/>
            <class name="com.nba.automation.DP2.runner.DP2TestRunner"/>
        </classes>
    </test>

    <!-- Firefox Execution -->
    <test name="Run on Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.nba.automation.coreproduct.runner.CPRunner"/>
            <class name="com.nba.automation.DP1.runner.DP1TestRunner"/>
            <class name="com.nba.automation.DP2.runner.DP2TestRunner"/>
        </classes>
    </test>

    <!-- Edge Execution -->
    <test name="Run on Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.nba.automation.coreproduct.runner.CPRunner"/>
            <class name="com.nba.automation.DP1.runner.DP1TestRunner"/>
            <class name="com.nba.automation.DP2.runner.DP2TestRunner"/>
        </classes>
    </test>
</suite>
